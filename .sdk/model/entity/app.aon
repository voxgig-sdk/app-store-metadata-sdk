      req: false
      short: "Primary app category"
      type: "`$STRING`"
    }
    {
      name: "currency"
      req: false
      short: "Currency code"
      type: "`$STRING`"
    }
    {
      name: "description"
      req: false
      short: "Full app description"
      type: "`$STRING`"
    }
    {
      name: "developer"
      req: false
      short: "Developer or publisher name"
      type: "`$STRING`"
    }
    {
      format: "uri"
      name: "iconUrl"
      req: false
      short: "URL to app icon image"
      type: "`$STRING`"
    }
    {
      name: "id"
      req: false
      type: "`$STRING`"
    }
    {
